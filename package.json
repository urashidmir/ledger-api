{
  "name": "simple-ledger-api",
  "version": "1.0.0",
  "description": "A simple in-memory ledger API (deposits, withdrawals, balance, transaction history)",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test src/*.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
